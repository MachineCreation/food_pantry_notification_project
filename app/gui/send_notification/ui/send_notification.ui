<?xml version='1.0' encoding='utf-8'?>
<interface version="1.5" author="PygubuDesigner 0.41.4">
  <project>
    <settings />
    <customwidgets />
    <resources />
  </project>
  <object class="ttk.Frame" id="send_notification" named="True">
    <layout manager="grid">
      <property name="column">0</property>
      <property name="row">0</property>
      <property name="sticky">nsew</property>
    </layout>
    <containerlayout manager="grid">
      <property name="anchor">center</property>
      <property type="col" id="0" name="weight">1</property>
      <property type="row" id="2" name="weight">1</property>
    </containerlayout>
    <child>
      <object class="ttk.Label" id="title" named="True">
        <property name="font">{ariel} 24 {bold}</property>
        <property name="text" translatable="yes">Food Pantry Notification Project</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="padx">50</property>
          <property name="pady">30</property>
          <property name="row">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Separator" id="separator3">
        <property name="orient">horizontal</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="pady">10</property>
          <property name="row">3</property>
          <property name="sticky">ew</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Label" id="label3">
        <property name="font">{ariel} 10 {}</property>
        <property name="text" translatable="yes">A Student Project 2026</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="padx">30</property>
          <property name="pady">10</property>
          <property name="row">4</property>
          <property name="sticky">e</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Separator" id="separator5">
        <property name="orient">horizontal</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="pady">10</property>
          <property name="row">1</property>
          <property name="sticky">ew</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Frame" id="main_frame" named="True">
        <layout manager="grid">
          <property name="column">0</property>
          <property name="padx">15</property>
          <property name="pady">0</property>
          <property name="row">2</property>
          <property name="sticky">nsew</property>
        </layout>
        <containerlayout manager="grid">
          <property name="anchor">center</property>
          <property type="col" id="0" name="minsize">500</property>
          <property type="row" id="0" name="minsize">75</property>
          <property type="row" id="0" name="weight">1</property>
        </containerlayout>
        <child>
          <object class="ttk.Label" id="SendNotificationLabel" named="True">
            <property name="font">{ariel} 16 {bold}</property>
            <property name="justify">center</property>
            <property name="text" translatable="yes">Send Notification</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="row">0</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Frame" id="frame1">
            <property name="height">200</property>
            <property name="width">200</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="ipady">10</property>
              <property name="pady">10</property>
              <property name="row">6</property>
              <property name="sticky">e</property>
            </layout>
            <containerlayout manager="grid">
              <property name="anchor">center</property>
            </containerlayout>
            <child>
              <object class="ttk.Button" id="send_button" named="True">
                <property name="text" translatable="yes">Send</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="padx">5</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Button" id="clear_button" named="True">
                <property name="text" translatable="yes">Clear</property>
                <layout manager="grid">
                  <property name="column">3</property>
                  <property name="padx">5</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Button" id="back_button" named="True">
                <property name="text" translatable="yes">Back</property>
                <layout manager="grid">
                  <property name="column">4</property>
                  <property name="padx">5</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="ttk.Frame" id="frame2">
            <property name="height">200</property>
            <property name="width">200</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="ipady">10</property>
              <property name="row">2</property>
              <property name="sticky">nsew</property>
            </layout>
            <containerlayout manager="grid">
              <property name="anchor">center</property>
              <property type="col" id="0" name="pad">30</property>
              <property type="col" id="0" name="weight">1</property>
              <property type="col" id="1" name="pad">20</property>
              <property type="col" id="1" name="weight">1</property>
              <property type="col" id="2" name="pad">20</property>
              <property type="col" id="2" name="weight">1</property>
              <property type="row" id="0" name="minsize">5</property>
              <property type="row" id="0" name="weight">1</property>
              <property type="row" id="1" name="pad">5</property>
              <property type="row" id="2" name="pad">5</property>
              <property type="row" id="3" name="pad">5</property>
              <property type="row" id="4" name="pad">5</property>
              <property type="row" id="4" name="weight">2</property>
              <property type="row" id="5" name="pad">5</property>
              <property type="row" id="5" name="weight">1</property>
            </containerlayout>
            <child>
              <object class="ttk.Label" id="SubjectLabel" named="True">
                <property name="font">{ariel} 12 {}</property>
                <property name="text" translatable="yes">Subject</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="row">2</property>
                  <property name="sticky">w</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Label" id="template_label" named="True">
                <property name="font">{ariel} 12 {}</property>
                <property name="text" translatable="yes">Template</property>
                <layout manager="grid">
                  <property name="column">1</property>
                  <property name="row">2</property>
                  <property name="sticky">w</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Combobox" id="template_entry" named="True">
                <property name="state">readonly</property>
                <property name="width">40</property>
                <layout manager="grid">
                  <property name="column">1</property>
                  <property name="row">3</property>
                  <property name="sticky">w</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Entry" id="subject_entry" named="True">
                <property name="font">{ariel} 12 {}</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="row">3</property>
                  <property name="sticky">w</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="ttk.Frame" id="frame3">
            <property name="height">200</property>
            <property name="width">200</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="row">5</property>
              <property name="sticky">nsew</property>
            </layout>
            <containerlayout manager="grid">
              <property name="anchor">center</property>
              <property type="col" id="0" name="weight">1</property>
            </containerlayout>
            <child>
              <object class="ttk.Labelframe" id="message_labelFrame" named="True">
                <property name="height">200</property>
                <property name="text" translatable="yes">Message</property>
                <property name="width">200</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="row">0</property>
                  <property name="sticky">nsew</property>
                </layout>
                <containerlayout manager="grid">
                  <property type="col" id="0" name="weight">1</property>
                  <property type="row" id="0" name="weight">1</property>
                </containerlayout>
                <child>
                  <object class="tk.Text" id="message_entry" named="True">
                    <property name="height">10</property>
                    <property name="width">50</property>
                    <layout manager="grid">
                      <property name="column">0</property>
                      <property name="row">0</property>
                      <property name="sticky">nsew</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Scrollbar" id="message_scroll" named="True">
                    <property name="orient">vertical</property>
                    <layout manager="grid">
                      <property name="column">1</property>
                      <property name="row">0</property>
                      <property name="sticky">ns</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>

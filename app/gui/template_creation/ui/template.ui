<?xml version='1.0' encoding='utf-8'?>
<interface version="1.5" author="PygubuDesigner 0.41.4">
  <project>
    <settings />
    <customwidgets />
    <resources />
  </project>
  <object class="tk.Tk" id="tk1">
    <property name="height">500</property>
    <property name="title" translatable="yes">Create Notification Template</property>
    <property name="width">490</property>
    <child>
      <object class="ttk.Frame" id="template_frame" named="True">
        <property name="height">200</property>
        <property name="width">200</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="ipadx">20</property>
          <property name="ipady">30</property>
          <property name="row">0</property>
        </layout>
        <child>
          <object class="ttk.Label" id="label1">
            <property name="font">{Yu Gothic UI} 14 {bold}</property>
            <property name="padding">10</property>
            <property name="text" translatable="yes">Food Pantry Notification Project</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">8</property>
              <property name="pady">30</property>
              <property name="row">0</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="template_title_label" named="True">
            <property name="font">{Yu Gothic UI} 12 {bold}</property>
            <property name="text" translatable="yes">Create Notification Template</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="pady">20</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Frame" id="frame2">
            <property name="height">200</property>
            <property name="width">200</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="ipadx">0</property>
              <property name="ipady">0</property>
              <property name="padx">100</property>
              <property name="pady">50</property>
              <property name="row">2</property>
            </layout>
            <child>
              <object class="ttk.Label" id="label3">
                <property name="padding">10</property>
                <property name="text" translatable="yes">Template Name:</property>
                <property name="width">-15</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="padx">8</property>
                  <property name="pady">8</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Entry" id="entry1">
                <property name="width">26</property>
                <layout manager="grid">
                  <property name="column">1</property>
                  <property name="ipady">5</property>
                  <property name="row">0</property>
                  <property name="sticky">w</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Label" id="label4">
                <property name="padding">10</property>
                <property name="text" translatable="yes">Subject:</property>
                <property name="width">-7</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="padx">8</property>
                  <property name="pady">8</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Entry" id="subject_entry" named="True">
                <property name="width">26</property>
                <layout manager="grid">
                  <property name="column">1</property>
                  <property name="ipady">5</property>
                  <property name="row">1</property>
                  <property name="sticky">w</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Label" id="label5">
                <property name="padding">10</property>
                <property name="text" translatable="yes">Message:</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="padx">8</property>
                  <property name="pady">8</property>
                  <property name="row">4</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="tk.Text" id="message_text" named="True">
                <property name="height">8</property>
                <property name="width">35</property>
                <layout manager="grid">
                  <property name="column">1</property>
                  <property name="ipadx">50</property>
                  <property name="ipady">30</property>
                  <property name="pady">30</property>
                  <property name="row">4</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Label" id="label17">
                <property name="text" translatable="yes">Tags:</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="row">2</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Combobox" id="tags_combobox" named="True">
                <layout manager="grid">
                  <property name="column">1</property>
                  <property name="ipady">5</property>
                  <property name="pady">10</property>
                  <property name="row">2</property>
                  <property name="sticky">w</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Label" id="label6">
                <property name="text" translatable="yes">Existing Templates:</property>
                <layout manager="grid">
                  <property name="column">2</property>
                  <property name="ipadx">7</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Combobox" id="existing_templates_combobox" named="True">
                <property name="state">readonly</property>
                <property name="width">26</property>
                <bind sequence="&lt;&lt;ComboboxSelected&gt;&gt;" handler="on_load_template" add="" />
                <layout manager="grid">
                  <property name="column">3</property>
                  <property name="ipady">5</property>
                  <property name="padx">15</property>
                  <property name="pady">8</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Label" id="label_image" named="True">
                <property name="text" translatable="yes">Image:</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="row">3</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Label" id="image_path_label" named="True">
                <property name="text" translatable="yes">No image selected</property>
                <layout manager="grid">
                  <property name="column">1</property>
                  <property name="ipady">5</property>
                  <property name="pady">10</property>
                  <property name="row">3</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="ttk.Frame" id="frame4">
            <property name="height">200</property>
            <property name="width">200</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="ipadx">0</property>
              <property name="padx">110</property>
              <property name="pady">60</property>
              <property name="row">2</property>
              <property name="sticky">e</property>
            </layout>
            <child>
              <object class="ttk.Button" id="save_button" named="True">
                <property name="command" type="command" cbtype="simple">on_save</property>
                <property name="text" translatable="yes">Save Template</property>
                <property name="width">14</property>
                <bind sequence="&lt;1&gt;" handler="on_save" add="" />
                <layout manager="grid">
                  <property name="column">3</property>
                  <property name="padx">5</property>
                  <property name="pady">5</property>
                  <property name="row">2</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Button" id="button2">
                <property name="command" type="command" cbtype="simple">on_clear</property>
                <property name="text" translatable="yes">Clear</property>
                <property name="width">14</property>
                <bind sequence="&lt;1&gt;" handler="on_clear" add="" />
                <layout manager="grid">
                  <property name="column">3</property>
                  <property name="padx">5</property>
                  <property name="pady">5</property>
                  <property name="row">4</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Button" id="button3">
                <property name="command" type="command" cbtype="simple">on_back</property>
                <property name="text" translatable="yes">Back</property>
                <property name="width">14</property>
                <layout manager="grid">
                  <property name="column">3</property>
                  <property name="padx">5</property>
                  <property name="pady">5</property>
                  <property name="row">5</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Button" id="button4">
                <property name="command" type="command" cbtype="simple">on_delete_template</property>
                <property name="text" translatable="yes">Delete Template</property>
                <layout manager="grid">
                  <property name="column">3</property>
                  <property name="padx">5</property>
                  <property name="pady">5</property>
                  <property name="row">3</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Button" id="upload_image_button" named="True">
                <property name="text" translatable="yes">Insert Image</property>
                <property name="width">14</property>
                <bind sequence="&lt;1&gt;" handler="on_upload_image" add="" />
                <layout manager="grid">
                  <property name="column">3</property>
                  <property name="padx">5</property>
                  <property name="pady">5</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Button" id="remove_image_button" named="True">
                <property name="text" translatable="yes">Remove Image</property>
                <property name="width">14</property>
                <bind sequence="&lt;1&gt;" handler="on_remove_image" add="" />
                <layout manager="grid">
                  <property name="column">3</property>
                  <property name="padx">5</property>
                  <property name="pady">5</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>

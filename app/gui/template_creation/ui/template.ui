<?xml version='1.0' encoding='utf-8'?>
<interface version="1.5" author="PygubuDesigner 0.41.4">
  <project>
    <settings />
    <customwidgets />
    <resources />
  </project>
  <object class="ttk.Frame" id="template_frame">
    <layout manager="grid">
      <property name="column">0</property>
      <property name="row">0</property>
      <property name="sticky">nsew</property>
    </layout>
    <containerlayout manager="grid">
      <property type="col" id="0" name="weight">1</property>
      <property type="row" id="3" name="weight">1</property>
      <property type="row" id="4" name="weight">1</property>
    </containerlayout>
    <child>
      <object class="ttk.Label" id="label1">
        <property name="font">{Yu Gothic UI} 14 {bold}</property>
        <property name="padding">10</property>
        <property name="text" translatable="yes">Food Pantry Notification Project</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="row">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Label" id="label2">
        <property name="font">{Yu Gothic UI} 12 {bold}</property>
        <property name="text" translatable="yes">Create Notification Template</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="pady">30</property>
          <property name="row">1</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Frame" id="frame2">
        <layout manager="grid">
          <property name="column">0</property>
          <property name="padx">50</property>
          <property name="row">2</property>
          <property name="sticky">nsew</property>
        </layout>
        <containerlayout manager="grid">
          <property name="anchor">center</property>
          <property type="col" id="0" name="weight">1</property>
          <property type="col" id="1" name="weight">1</property>
          <property type="col" id="2" name="weight">1</property>
          <property type="col" id="3" name="weight">1</property>
          <property type="col" id="4" name="weight">1</property>
          <property type="row" id="0" name="weight">1</property>
          <property type="row" id="1" name="weight">2</property>
          <property type="row" id="2" name="weight">1</property>
        </containerlayout>
        <child>
          <object class="ttk.Label" id="label3">
            <property name="padding">0</property>
            <property name="text" translatable="yes">Template Name:</property>
            <property name="width">-15</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">8</property>
              <property name="pady">8</property>
              <property name="row">0</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Entry" id="entry1">
            <property name="width">26</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="ipady">5</property>
              <property name="pady">22</property>
              <property name="row">0</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="label4">
            <property name="padding">0</property>
            <property name="text" translatable="yes">Subject:</property>
            <property name="width">-7</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">8</property>
              <property name="pady">8</property>
              <property name="row">1</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Entry" id="subject_entry" named="True">
            <property name="width">26</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="ipady">5</property>
              <property name="row">1</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Combobox" id="tags_combobox" named="True">
            <property name="state">readonly</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="ipady">5</property>
              <property name="pady">10</property>
              <property name="row">2</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="label6">
            <property name="text" translatable="yes">Existing Templates:</property>
            <layout manager="grid">
              <property name="column">3</property>
              <property name="ipadx">7</property>
              <property name="row">0</property>
              <property name="sticky">e</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Combobox" id="existing_templates_combobox" named="True">
            <property name="state">readonly</property>
            <property name="width">26</property>
            <bind sequence="&lt;&lt;ComboboxSelected&gt;&gt;" handler="on_load_template" add="" />
            <layout manager="grid">
              <property name="column">4</property>
              <property name="ipady">5</property>
              <property name="row">0</property>
              <property name="sticky">e</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="label8">
            <property name="padding">0</property>
            <property name="text" translatable="yes">Tags:</property>
            <property name="width">-15</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">8</property>
              <property name="pady">8</property>
              <property name="row">2</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="ttk.Frame" id="frame4">
        <layout manager="grid">
          <property name="column">0</property>
          <property name="columnspan">2</property>
          <property name="ipady">20</property>
          <property name="row">5</property>
          <property name="sticky">nsew</property>
        </layout>
        <containerlayout manager="grid">
          <property name="anchor">center</property>
        </containerlayout>
        <child>
          <object class="ttk.Button" id="button1">
            <property name="padding">7</property>
            <property name="text" translatable="yes">Save Template</property>
            <property name="width">15</property>
            <bind sequence="&lt;1&gt;" handler="on_save" add="" />
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">5</property>
              <property name="pady">5</property>
              <property name="row">0</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Button" id="button2">
            <property name="padding">7</property>
            <property name="text" translatable="yes">Cancel</property>
            <property name="width">15</property>
            <bind sequence="&lt;1&gt;" handler="on_cancel" add="" />
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">5</property>
              <property name="pady">5</property>
              <property name="row">0</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="ttk.Frame" id="frame1">
        <layout manager="grid">
          <property name="column">0</property>
          <property name="padx">50</property>
          <property name="row">4</property>
          <property name="sticky">nsew</property>
        </layout>
        <containerlayout manager="grid">
          <property name="anchor">center</property>
          <property type="col" id="0" name="weight">1</property>
          <property type="row" id="1" name="weight">1</property>
        </containerlayout>
        <child>
          <object class="ttk.Label" id="label7">
            <property name="padding">10</property>
            <property name="text" translatable="yes">Message:</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="row">0</property>
              <property name="sticky">nw</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="tk.Text" id="message_text" named="True">
            <property name="height">5</property>
            <property name="width">30</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="row">1</property>
              <property name="sticky">nsew</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>

<?xml version='1.0' encoding='utf-8'?>
<interface version="1.5" author="PygubuDesigner 0.41.4">
  <project>
    <settings />
    <customwidgets />
    <resources />
  </project>
  <object class="ttk.Frame" id="dashboard" named="True">
    <property name="height">200</property>
    <property name="width">200</property>
    <layout manager="grid">
      <property name="column">0</property>
      <property name="row">0</property>
      <property name="sticky">nsew</property>
    </layout>
    <containerlayout manager="grid">
      <property name="anchor">center</property>
      <property type="col" id="0" name="weight">1</property>
      <property type="row" id="0" name="weight">1</property>
      <property type="row" id="1" name="weight">1</property>
      <property type="row" id="2" name="weight">1</property>
      <property type="row" id="3" name="weight">1</property>
      <property type="row" id="4" name="weight">1</property>
    </containerlayout>
    <child>
      <object class="ttk.Label" id="title" named="True">
        <property name="font">{ariel} 14 {bold}</property>
        <property name="justify">left</property>
        <property name="text" translatable="yes">Food Pantry Notification Project</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="padx">15</property>
          <property name="pady">30</property>
          <property name="row">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Separator" id="separator3">
        <property name="orient">horizontal</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="pady">10</property>
          <property name="row">3</property>
          <property name="sticky">ew</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Label" id="label3">
        <property name="font">{ariel} 10 {}</property>
        <property name="text" translatable="yes">A Student Project 2026</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="padx">30</property>
          <property name="pady">10</property>
          <property name="row">4</property>
          <property name="sticky">e</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Separator" id="separator5">
        <property name="orient">horizontal</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="pady">5</property>
          <property name="row">1</property>
          <property name="sticky">ew</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Frame" id="frame8">
        <property name="height">200</property>
        <property name="width">200</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="ipady">15</property>
          <property name="padx">15</property>
          <property name="pady">5</property>
          <property name="row">2</property>
          <property name="sticky">nsew</property>
        </layout>
        <containerlayout manager="grid">
          <property name="anchor">center</property>
          <property type="col" id="0" name="weight">1</property>
          <property type="row" id="1" name="weight">1</property>
        </containerlayout>
        <child>
          <object class="ttk.Frame" id="frame1">
            <property name="height">200</property>
            <property name="width">200</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="columnspan">2</property>
              <property name="ipady">10</property>
              <property name="pady">10</property>
              <property name="row">1</property>
              <property name="sticky">nsew</property>
            </layout>
            <containerlayout manager="grid">
              <property type="col" id="0" name="weight">1</property>
              <property type="col" id="1" name="weight">1</property>
              <property type="col" id="2" name="weight">1</property>
              <property type="row" id="0" name="weight">2</property>
              <property type="row" id="1" name="minsize">1</property>
              <property type="row" id="1" name="weight">1</property>
            </containerlayout>
            <child>
              <object class="ttk.Frame" id="frame4">
                <property name="height">200</property>
                <property name="width">200</property>
                <layout manager="grid">
                  <property name="column">2</property>
                  <property name="ipadx">10</property>
                  <property name="padx">10</property>
                  <property name="row">0</property>
                  <property name="sticky">nsew</property>
                </layout>
                <containerlayout manager="grid">
                  <property name="anchor">e</property>
                  <property type="row" id="0" name="weight">1</property>
                  <property type="row" id="1" name="weight">1</property>
                  <property type="row" id="2" name="weight">1</property>
                  <property type="row" id="3" name="weight">1</property>
                </containerlayout>
                <child>
                  <object class="ttk.Button" id="send_notification_button" named="True">
                    <property name="text" translatable="yes">Send Notificcation</property>
                    <layout manager="grid">
                      <property name="column">0</property>
                      <property name="padx">5</property>
                      <property name="row">0</property>
                      <property name="sticky">e</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Button" id="create_template_button" named="True">
                    <property name="text" translatable="yes">Create Template</property>
                    <layout manager="grid">
                      <property name="column">0</property>
                      <property name="padx">5</property>
                      <property name="row">2</property>
                      <property name="sticky">e</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Button" id="manage_users_button" named="True">
                    <property name="text" translatable="yes">Manage Users</property>
                    <layout manager="grid">
                      <property name="column">0</property>
                      <property name="padx">5</property>
                      <property name="row">3</property>
                      <property name="sticky">e</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Button" id="notification_log_button" named="True">
                    <property name="text" translatable="yes">Notification Log</property>
                    <layout manager="grid">
                      <property name="column">0</property>
                      <property name="padx">5</property>
                      <property name="row">1</property>
                      <property name="sticky">e</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="ttk.Labelframe" id="recent_notes_frame" named="True">
                <property name="height">200</property>
                <property name="text" translatable="yes">Recent Notifications
</property>
                <property name="width">200</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="columnspan">2</property>
                  <property name="row">0</property>
                  <property name="rowspan">2</property>
                  <property name="sticky">nsew</property>
                </layout>
                <containerlayout manager="grid">
                  <property type="col" id="0" name="weight">1</property>
                  <property type="row" id="0" name="weight">1</property>
                </containerlayout>
                <child>
                  <object class="tk.Text" id="recent_notes_text" named="True">
                    <property name="height">10</property>
                    <property name="text" translatable="yes">This area will house the 5 most recent notifications.

----------

In blocks seperated by delineators.

----------

Like this.

----------

There is more here when you scroll</property>
                    <property name="width">50</property>
                    <property name="wrap">word</property>
                    <layout manager="grid">
                      <property name="column">0</property>
                      <property name="row">0</property>
                      <property name="sticky">nsew</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="ttk.Scrollbar" id="recent_notes_scroll" named="True">
                    <property name="orient">vertical</property>
                    <property name="takefocus">true</property>
                    <layout manager="grid">
                      <property name="column">1</property>
                      <property name="row">0</property>
                      <property name="sticky">nsew</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="ttk.Frame" id="frame3">
                <property name="height">200</property>
                <property name="width">200</property>
                <layout manager="grid">
                  <property name="column">2</property>
                  <property name="row">1</property>
                  <property name="sticky">nsew</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="ttk.Frame" id="frame2">
            <property name="height">200</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="row">0</property>
              <property name="sticky">nsew</property>
            </layout>
            <containerlayout manager="grid">
              <property type="col" id="1" name="weight">1</property>
            </containerlayout>
            <child>
              <object class="ttk.Label" id="label1" named="True">
                <property name="font">{ariel} 16 {bold}</property>
                <property name="justify">left</property>
                <property name="text" translatable="yes">Welcome to the pantry!</property>
                <layout manager="grid">
                  <property name="column">0</property>
                  <property name="row">0</property>
                  <property name="sticky">w</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="ttk.Button" id="log_out_button" named="True">
                <property name="text" translatable="yes">Log Out</property>
                <layout manager="grid">
                  <property name="column">2</property>
                  <property name="padx">15</property>
                  <property name="row">0</property>
                  <property name="sticky">e</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>